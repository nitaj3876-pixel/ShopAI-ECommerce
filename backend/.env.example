# Copy this file to .env and fill in real values before running in production.

# --- Database ---
# For quick local/demo use, the app defaults to SQLite (no setup needed).
# For production, point this at PostgreSQL instead:
# DATABASE_URL=postgresql://ecommerce_user:ecommerce_pass@localhost:5432/ecommerce_db
DATABASE_URL=sqlite:///./ecommerce.db

# --- Auth ---
JWT_SECRET_KEY=change-this-to-a-long-random-secret-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Admin bootstrap (created by seed.py) ---
ADMIN_EMAIL=admin@shopai.com
ADMIN_PASSWORD=Admin@123

# --- CORS ---
FRONTEND_ORIGIN=http://localhost:5500

# --- Payments (demo/test keys only — replace with real ones for production) ---
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxx
STRIPE_SECRET_KEY=sk_test_xxxxxxxx
